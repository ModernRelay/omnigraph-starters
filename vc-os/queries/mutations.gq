// VC OS — Mutations. One add_<node> per node type and one link_<verb> per edge type.
// All values pass through $params; never string-interpolate into the mutation body.
// Edge properties (Knows.strength, WorksAt.role, BoardMemberAt.role, etc.) are
// loaded via JSONL `data:` field for bulk seeds; only the critical ones are exposed
// as mutation params.

// ──────────────────────────────────────────────
// Core nodes
// ──────────────────────────────────────────────

query add_organization($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Organization { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_person($slug: String, $name: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Person { slug: $slug, name: $name, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_market($slug: String, $name: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Market { slug: $slug, name: $name, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_deal($slug: String, $name: String, $stage: String, $outcome: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Deal { slug: $slug, name: $name, stage: $stage, outcome: $outcome, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_fund($slug: String, $name: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Fund { slug: $slug, name: $name, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_artifact($slug: String, $name: String, $kind: String, $source: String, $source_app: String, $date: Date, $captured_at: DateTime, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Artifact { slug: $slug, name: $name, kind: $kind, source: $source, source_app: $source_app, date: $date, captured_at: $captured_at, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_meeting($slug: String, $name: String, $kind: String, $scheduled_at: DateTime, $status: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Meeting { slug: $slug, name: $name, kind: $kind, scheduled_at: $scheduled_at, status: $status, createdAt: $createdAt, updatedAt: $updatedAt }
}

// Git-pinned markdown artifact. `kind` defaults to "markdown" and `source` to
// "github" semantically; pass them in for forward-compat with other VCS or doc kinds.
// `body` carries the cached text at `commit_sha`; importer/cron updates both in lockstep.
query add_markdown_artifact($slug: String, $name: String, $kind: String, $source: String,
                            $repo: String, $path: String, $commit_sha: String, $branch: String,
                            $url: String, $body: String,
                            $date: Date, $captured_at: DateTime, $last_synced_at: DateTime,
                            $createdAt: DateTime, $updatedAt: DateTime) {
    insert Artifact {
        slug: $slug, name: $name, kind: $kind, source: $source,
        repo: $repo, path: $path, commit_sha: $commit_sha, branch: $branch,
        url: $url, body: $body,
        date: $date, captured_at: $captured_at, last_synced_at: $last_synced_at,
        createdAt: $createdAt, updatedAt: $updatedAt
    }
}


// ──────────────────────────────────────────────
// Growth-ring nodes
// ──────────────────────────────────────────────

query add_thesis($slug: String, $name: String, $status: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Thesis { slug: $slug, name: $name, status: $status, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_assumption($slug: String, $name: String, $level: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Assumption { slug: $slug, name: $name, level: $level, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_question($slug: String, $name: String, $status: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Question { slug: $slug, name: $name, status: $status, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_signal($slug: String, $name: String, $kind: String, $date: Date, $stagingTimestamp: DateTime, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Signal { slug: $slug, name: $name, kind: $kind, date: $date, stagingTimestamp: $stagingTimestamp, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_insight($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Insight { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }
}

// IC-debate variant: same as add_insight but also sets stance + summary at
// create time, so the resulting Insight participates in debate-stances reads.
// Multi-agent IC simulation (bull + bear in parallel) uses this.
query add_insight_with_stance($slug: String, $name: String, $kind: String, $stance: String, $summary: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Insight { slug: $slug, name: $name, kind: $kind, stance: $stance, summary: $summary, createdAt: $createdAt, updatedAt: $updatedAt }
}

// Convenience helper for publisher / database / expert-network orgs with a
// reliability rating. Use the generic `add_organization` for everything else.
query add_publisher_organization($slug: String, $name: String, $kind: String, $reliability: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Organization { slug: $slug, name: $name, kind: $kind, reliability: $reliability, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_chunk($slug: String, $text: String, $chunk_index: I32, $createdAt: DateTime) {
    insert Chunk { slug: $slug, text: $text, chunk_index: $chunk_index, createdAt: $createdAt }
}

query add_decision($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Decision { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_commitment($slug: String, $name: String, $status: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Commitment { slug: $slug, name: $name, status: $status, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_pattern($slug: String, $name: String, $kind: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Pattern { slug: $slug, name: $name, kind: $kind, createdAt: $createdAt, updatedAt: $updatedAt }
}

query add_lesson($slug: String, $name: String, $kind: String, $body: String, $status: String, $createdAt: DateTime, $updatedAt: DateTime) {
    insert Lesson { slug: $slug, name: $name, kind: $kind, body: $body, status: $status, createdAt: $createdAt, updatedAt: $updatedAt }
}


// ══════════════════════════════════════════════
// EDGE MUTATIONS — Engagement loop
// ══════════════════════════════════════════════

query link_deal_organization($deal: String, $organization: String) {
    insert ForOrganization { from: $deal, to: $organization }
}

query link_deal_fund($deal: String, $fund: String) {
    insert FromFund { from: $deal, to: $fund }
}

query link_deal_lead($deal: String, $person: String) {
    insert LedByPerson { from: $deal, to: $person }
}

query link_deal_thesis($deal: String, $thesis: String) {
    insert RelevantThesis { from: $deal, to: $thesis }
}

query link_deal_market($deal: String, $market: String) {
    insert RelevantMarket { from: $deal, to: $market }
}

query link_deal_lead_investor($deal: String, $organization: String) {
    insert LeadInvestor { from: $deal, to: $organization }
}

query link_deal_participant($deal: String, $organization: String) {
    insert ParticipantInvestor { from: $deal, to: $organization }
}

// Knows is symmetric — this mutation inserts both directions in one call so
// callers can't accidentally create a one-way relationship. Knows does not
// declare @unique(src, dst), so this mutation remains the convention.
query link_knows($from: String, $to: String) {
    insert Knows { from: $from, to: $to }
    insert Knows { from: $to, to: $from }
}

query link_works_at($from: String, $to: String) {
    insert WorksAt { from: $from, to: $to }
}

query link_founder_of($person: String, $organization: String) {
    insert FounderOf { from: $person, to: $organization }
}

query link_board_member_at($person: String, $organization: String) {
    insert BoardMemberAt { from: $person, to: $organization }
}

query link_role_in_deal($person: String, $deal: String, $role: String) {
    insert RoleInDeal { from: $person, to: $deal, role: $role }
}

query link_decision_maker_at($person: String, $organization: String) {
    insert DecisionMakerAt { from: $person, to: $organization }
}

query link_would_acquire($from: String, $to: String) {
    insert WouldAcquire { from: $from, to: $to }
}

query link_lp_in_fund($organization: String, $fund: String) {
    insert LpInFund { from: $organization, to: $fund }
}

query link_organization_in_market($organization: String, $market: String) {
    insert OrganizationInMarket { from: $organization, to: $market }
}


